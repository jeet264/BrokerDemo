@BrokerOS.Api_HostAddress = http://localhost:5000

GET {{BrokerOS.Api_HostAddress}}/health

###

GET {{BrokerOS.Api_HostAddress}}/api/system/status
Accept: application/json

###

POST {{BrokerOS.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@apexbrokers.in",
  "password": "Demo@12345"
}

###

POST {{BrokerOS.Api_HostAddress}}/api/auth/register-organization
Content-Type: application/json

{
  "organizationName": "North Star Brokers",
  "organizationCode": "NORTHSTAR",
  "adminFullName": "Priya Shah",
  "adminEmail": "priya@northstarbrokers.in",
  "adminPassword": "Demo@12345"
}

###

GET {{BrokerOS.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

GET {{BrokerOS.Api_HostAddress}}/api/organizations/current
Authorization: Bearer {{token}}

###

GET {{BrokerOS.Api_HostAddress}}/api/clients?search=&clientType=&industry=&isActive=true&sortBy=companyName&sortDir=asc&page=1&pageSize=20
Authorization: Bearer {{token}}

###

POST {{BrokerOS.Api_HostAddress}}/api/clients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientCode": "CLI-001",
  "companyName": "Sharma Logistics Pvt Ltd",
  "clientType": "Corporate",
  "industry": "Logistics",
  "email": "ops@sharmalogistics.in",
  "phone": "+91 98765 43210",
  "addressLine1": "12 Andheri East",
  "city": "Mumbai",
  "state": "Maharashtra",
  "postalCode": "400069",
  "country": "India",
  "isActive": true
}

###

GET {{BrokerOS.Api_HostAddress}}/api/dashboard/renewals
Authorization: Bearer {{token}}

###

GET {{BrokerOS.Api_HostAddress}}/api/renewals?search=&status=&dueWithinDays=30&sortBy=renewalDate&sortDir=asc&page=1&pageSize=20
Authorization: Bearer {{token}}

###

POST {{BrokerOS.Api_HostAddress}}/api/renewals/00000000-0000-0000-0000-000000000000/follow-up
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "activityType": "Call",
  "description": "Spoke with the client about upcoming motor renewal.",
  "nextFollowUpAtUtc": "2026-08-20T10:00:00Z",
  "createTask": true,
  "taskTitle": "Call Sharma Logistics about quotation",
  "taskDueDateUtc": "2026-08-20T10:00:00Z"
}

###

GET {{BrokerOS.Api_HostAddress}}/api/policies?status=Active&sortBy=expiryDate&page=1&pageSize=20
Authorization: Bearer {{token}}

###

PUT {{BrokerOS.Api_HostAddress}}/api/renewals/00000000-0000-0000-0000-000000000000/complete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newExpiryDate": "2027-08-20",
  "premium": 125000,
  "notes": "Client accepted the renewal quote."
}

###

PUT {{BrokerOS.Api_HostAddress}}/api/renewals/00000000-0000-0000-0000-000000000000/lost
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Client moved to another broker"
}
