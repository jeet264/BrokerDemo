## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
logs/

# Visual Studio
.vs/
*.userprefs
*.pidb
*.svclog
*.pdb
*.mdb
project.lock.json
project.fragment.lock.json
artifacts/

# .NET
*.nuget.props
*.nuget.targets
*.nupkg
*.snupkg

# ASP.NET
appsettings.*.local.json

# Secrets and environment
.env
.env.local
.env.*.local
secrets.json

# SQL / local databases
*.mdf
*.ldf
*.ndf

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
*.swp
*~

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
frontend/web/.env
frontend/web/.env.local

# Test / coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# Others
*.log
publish/
