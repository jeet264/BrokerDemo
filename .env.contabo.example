# ============================================
# BrokerOS Contabo Configuration
# ============================================
# For servers with existing Nginx on ports 80/443
# Copy to .env on server: cp .env.contabo.example .env

# ============================================
# SERVER CONFIGURATION
# ============================================

# Public URL - use your server IP or domain
# This is used for CORS - must match how users access the site
PUBLIC_ORIGIN=http://217.217.249.136

# API URL for frontend (empty = same origin, or specify full URL)
VITE_API_BASE_URL=

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQL Server password - MUST be strong
# (8+ chars, uppercase, lowercase, number, symbol)
MSSQL_SA_PASSWORD=BrokerOS_Prod_2024!

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT signing key - at least 32 characters
# Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ============================================
# APPLICATION SETTINGS
# ============================================

# Demo mode (set both to false for production)
SEED_DEMO_DATA=true
ENABLE_DEMO_RESET=true
ENABLE_SWAGGER=true
