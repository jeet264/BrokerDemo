# Copy to `.env` on the server. Never commit the real `.env`.

# Use `:80` first so you can test with the server IP over HTTP.
# After DNS points at this machine, change to your domain, e.g. demo.yourdomain.in
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://YOUR_SERVER_IP
ACME_EMAIL=you@yourdomain.in

# SQL Server Linux needs ~2 GB RAM. Use a 4 GB VPS.
MSSQL_SA_PASSWORD=ChangeMe_Sql_Password_Here_1

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=ChangeMe_Jwt_Signing_Key_At_Least_32_Chars

# Hosted demo (Apex book + Settings reset). Set both to false for a real customer.
SEED_DEMO_DATA=true
ENABLE_DEMO_RESET=true
