# ============================================
# BrokerOS Production Environment Configuration
# ============================================
# Copy to `.env` on the server. Never commit the real `.env`.
# 
# For Contabo VPS deployment:
# 1. Copy this file: cp .env.production.example .env
# 2. Edit values below with your actual settings
# 3. Run: docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# ============================================
# SERVER CONFIGURATION
# ============================================

# Use `:80` for IP-based access (first setup)
# Change to your domain for HTTPS: demo.yourdomain.in
SITE_ADDRESS=:80

# Public URL for CORS - use your Contabo server IP initially
# Example: http://123.45.67.89 (replace with your actual IP)
# For HTTPS later: https://demo.yourdomain.in
PUBLIC_ORIGIN=http://YOUR_CONTABO_IP

# Email for Let's Encrypt HTTPS certificates (required for domain setup)
ACME_EMAIL=your-email@domain.com

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQL Server password - MUST be strong (8+ chars, uppercase, lowercase, number, symbol)
# Generate a strong password: openssl rand -base64 24
# SQL Server Linux requires ~2 GB RAM minimum. Use a 4 GB VPS.
MSSQL_SA_PASSWORD=ChangeMe_Sql_Password_Here_1

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT signing key - at least 32 characters
# Generate with: openssl rand -base64 48
JWT_KEY=ChangeMe_Jwt_Signing_Key_At_Least_32_Chars

# ============================================
# APPLICATION SETTINGS
# ============================================

# Demo mode settings (for demo/testing environments)
# Set both to false for production customer deployments
SEED_DEMO_DATA=true
ENABLE_DEMO_RESET=true

# ============================================
# GITHUB CONTAINER REGISTRY (Optional - for CI/CD)
# ============================================
# Uncomment if using pre-built images from GitHub Container Registry
# GHCR_TOKEN=your_github_token_here
